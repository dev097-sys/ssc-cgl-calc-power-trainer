<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f172a">
<title>SSC CGL Calculation Power Trainer</title>
<style>
:root{
  --bg:#f4f6fb; --card:#ffffff; --ink:#0f172a; --muted:#64748b; --line:#e2e8f0;
  --accent:#2563eb; --accent-ink:#ffffff; --good:#16a34a; --bad:#dc2626; --warn:#d97706;
  --chip:#eef2ff; --shadow:0 1px 3px rgba(15,23,42,.08),0 4px 14px rgba(15,23,42,.06);
  --radius:14px;
}
html[data-theme="dark"]{
  --bg:#0b1220; --card:#131c2e; --ink:#e5eaf3; --muted:#93a1b8; --line:#253248;
  --accent:#3b82f6; --accent-ink:#ffffff; --good:#4ade80; --bad:#f87171; --warn:#fbbf24;
  --chip:#1b2942; --shadow:0 1px 3px rgba(0,0,0,.4),0 4px 14px rgba(0,0,0,.3);
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:16px;line-height:1.45;overflow-x:hidden}
button{font:inherit;color:inherit;cursor:pointer;border:none;background:none}
input,select{font:inherit;color:var(--ink)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px;border-radius:6px}
.app{max-width:960px;margin:0 auto;padding:0 14px calc(76px + env(safe-area-inset-bottom))}
header.topbar{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--line);padding:10px 14px;display:flex;align-items:center;gap:10px}
.topbar .title{font-weight:800;font-size:1.05rem;letter-spacing:.2px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topbar .sub{font-size:.72rem;color:var(--muted);display:block;font-weight:500}
.icon-btn{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--chip);font-size:1.15rem}
.screen{display:none;padding-top:16px}
.screen.active{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
h1{font-size:1.35rem;margin:6px 0 12px}
h2{font-size:1.1rem;margin:18px 0 8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;margin-bottom:12px}
.grid{display:grid;gap:10px}
.grid.cols2{grid-template-columns:1fr 1fr}
.grid.cols3{grid-template-columns:repeat(3,1fr)}
@media(max-width:560px){.grid.cols3{grid-template-columns:1fr 1fr}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--chip);border-radius:12px;padding:12px 16px;font-weight:600;min-height:48px;text-align:center}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.good{background:var(--good);color:#fff}
.btn.bad{background:var(--bad);color:#fff}
.btn.ghost{background:transparent;border:1px solid var(--line)}
.btn.block{width:100%}
.btn:active{transform:scale(.97)}
.btn[disabled]{opacity:.45;pointer-events:none}
.chip{display:inline-block;background:var(--chip);border-radius:999px;padding:4px 12px;font-size:.8rem;font-weight:600;margin:2px 4px 2px 0}
.muted{color:var(--muted)}
.small{font-size:.82rem}
.stat-big{font-size:1.6rem;font-weight:800}
.stat-label{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
/* question display */
.q-meta{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.q-text{font-size:clamp(2rem,9vw,3.2rem);font-weight:800;text-align:center;padding:22px 8px;font-variant-numeric:tabular-nums;word-break:break-word}
.q-hint{text-align:center;color:var(--muted);font-size:.85rem;margin-top:-12px;padding-bottom:8px}
.answer-row{display:flex;gap:8px}
.answer-input{flex:1;font-size:1.5rem;font-weight:700;padding:12px 14px;border:2px solid var(--line);border-radius:12px;background:var(--card);text-align:center;font-variant-numeric:tabular-nums;min-width:0}
.answer-input:focus{border-color:var(--accent);outline:none}
.keypad{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.keypad button{background:var(--chip);border-radius:12px;font-size:1.3rem;font-weight:700;padding:14px 0;min-height:52px}
.keypad button:active{background:var(--accent);color:#fff}
.feedback{margin-top:12px;padding:12px;border-radius:12px;font-weight:600;display:none}
.feedback.ok{display:block;background:rgba(22,163,74,.12);color:var(--good)}
.feedback.no{display:block;background:rgba(220,38,38,.12);color:var(--bad)}
.explain{margin-top:12px;padding:14px;border-radius:12px;background:var(--chip);display:none}
.explain.show{display:block}
.explain h3{margin:0 0 6px;font-size:.95rem}
.timerbar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:8px 0}
.timerbar>div{height:100%;background:var(--accent);width:100%;transition:width .2s linear}
.timerbar.low>div{background:var(--bad)}
.timer-num{font-variant-numeric:tabular-nums;font-weight:800;font-size:1.1rem}
/* bottom nav */
nav.bottom{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--card);border-top:1px solid var(--line);display:flex;padding-bottom:env(safe-area-inset-bottom)}
nav.bottom button{flex:1;padding:8px 2px 10px;font-size:.68rem;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:2px;font-weight:600}
nav.bottom button .ic{font-size:1.25rem}
nav.bottom button.on{color:var(--accent)}
/* tables */
table.tbl{width:100%;border-collapse:collapse;font-size:.85rem}
.tbl th,.tbl td{padding:8px 6px;text-align:left;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
.tbl th{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.4px}
.bar{height:10px;background:var(--line);border-radius:99px;overflow:hidden;min-width:60px}
.bar>div{height:100%;background:var(--accent)}
.err-item{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;background:var(--card)}
.err-item .q{font-weight:800;font-size:1.15rem;font-variant-numeric:tabular-nums}
.mode-card{display:flex;gap:12px;align-items:flex-start;text-align:left;width:100%}
.mode-card .ic{font-size:1.5rem;line-height:1;padding-top:2px}
.mode-card b{display:block}
select.sel,input.inp{width:100%;padding:12px;border:2px solid var(--line);border-radius:12px;background:var(--card);min-height:48px}
label.lbl{display:block;font-size:.8rem;font-weight:700;color:var(--muted);margin:10px 0 4px;text-transform:uppercase;letter-spacing:.4px}
.row{display:flex;gap:8px;flex-wrap:wrap}
.pill-toggle{display:flex;gap:6px;flex-wrap:wrap}
.pill-toggle .btn{padding:9px 14px;min-height:42px}
.pill-toggle .btn.sel{background:var(--accent);color:var(--accent-ink)}
.dialog-back{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;place-items:center;z-index:60;padding:20px}
.dialog-back.show{display:grid}
.dialog{background:var(--card);border-radius:16px;padding:20px;max-width:420px;width:100%;max-height:85vh;overflow:auto}
.kbd{display:none}
@media(hover:hover) and (pointer:fine){.kbd{display:inline}}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:99px;font-weight:600;font-size:.85rem;opacity:0;transition:opacity .25s;z-index:80;pointer-events:none;max-width:90vw;text-align:center}
.toast.show{opacity:1}
.streak-flame{color:var(--warn)}
.diff-tag{font-size:.7rem;padding:2px 8px;border-radius:99px;background:var(--chip);font-weight:700}
.progress-dots{display:flex;gap:4px;flex-wrap:wrap;margin:6px 0}
.progress-dots span{width:10px;height:10px;border-radius:99px;background:var(--line)}
.progress-dots span.done{background:var(--good)}
.progress-dots span.miss{background:var(--bad)}
.progress-dots span.cur{background:var(--accent);transform:scale(1.3)}
.technique{border-left:4px solid var(--accent);padding:10px 12px;background:var(--chip);border-radius:0 10px 10px 0;margin:8px 0}
.technique b{display:block}
canvas.chart{width:100%;height:180px}
</style>
</head>
<body>
<header class="topbar">
  <button class="icon-btn" id="btn-back" aria-label="Back" style="display:none">←</button>
  <div class="title">⚡ Calc Power <span class="sub">SSC CGL Tier 1 · Calculation Fluency</span></div>
  <button class="icon-btn" id="btn-theme" aria-label="Toggle theme">🌙</button>
</header>
<div class="app" id="app">

<!-- ================= HOME ================= -->
<section class="screen" id="scr-home" data-nav="home">
  <div class="card">
    <div class="row" style="justify-content:space-between;align-items:center">
      <div><div class="stat-label">Today</div><div class="stat-big" id="home-today">0</div><div class="muted small">questions</div></div>
      <div><div class="stat-label">Streak</div><div class="stat-big streak-flame" id="home-streak">0🔥</div><div class="muted small">days</div></div>
      <div><div class="stat-label">Accuracy</div><div class="stat-big" id="home-acc">–</div><div class="muted small">all time</div></div>
    </div>
  </div>
  <div class="card" id="home-reco">
    <h2 style="margin-top:0">Recommended next</h2>
    <div id="home-reco-body" class="muted small">Practice a few sessions to unlock recommendations.</div>
  </div>
  <div class="grid cols2">
    <button class="btn primary" data-go="config" data-mode="rapid">⚡ Rapid Fire</button>
    <button class="btn primary" data-go="config" data-mode="sprint">⏱️ Timed Sprint</button>
    <button class="btn" data-go="config" data-mode="mixed">🎲 Mixed Challenge</button>
    <button class="btn" data-go="benchmark">📏 Daily Benchmark</button>
    <button class="btn" data-go="config" data-mode="weak">🎯 Weakness Training</button>
    <button class="btn" data-go="errors">📓 Error Notebook</button>
  </div>
  <h2>Practice modes</h2>
  <div class="grid" id="mode-list"></div>
  <h2>Topics</h2>
  <div class="grid cols2" id="topic-list"></div>
</section>

<!-- ================= CONFIG ================= -->
<section class="screen" id="scr-config">
  <h1 id="cfg-title">Session setup</h1>
  <div class="card">
    <div id="cfg-learn" class="technique" style="display:none"></div>
    <label class="lbl">Topics</label>
    <div class="pill-toggle" id="cfg-topics"></div>
    <label class="lbl">Difficulty</label>
    <div class="pill-toggle" id="cfg-diff">
      <button class="btn" data-diff="1">Foundational</button>
      <button class="btn" data-diff="2">Intermediate</button>
      <button class="btn" data-diff="3">Exam</button>
      <button class="btn sel" data-diff="0">Adaptive</button>
    </div>
    <div id="cfg-sprint-len-wrap">
      <label class="lbl">Sprint length</label>
      <div class="pill-toggle" id="cfg-sprint-len">
        <button class="btn" data-sec="30">30s</button>
        <button class="btn sel" data-sec="60">1 min</button>
        <button class="btn" data-sec="180">3 min</button>
        <button class="btn" data-sec="300">5 min</button>
        <button class="btn" data-sec="600">10 min</button>
      </div>
    </div>
    <div id="cfg-count-wrap">
      <label class="lbl">Number of questions</label>
      <div class="pill-toggle" id="cfg-count">
        <button class="btn" data-n="10">10</button>
        <button class="btn sel" data-n="20">20</button>
        <button class="btn" data-n="40">40</button>
      </div>
    </div>
    <div style="margin-top:16px"><button class="btn primary block" id="cfg-start">Start session →</button></div>
  </div>
  <div class="card small muted" id="cfg-mode-desc"></div>
</section>

<!-- ================= SESSION ================= -->
<section class="screen" id="scr-session">
  <div class="q-meta">
    <span class="chip" id="sess-topic">Topic</span>
    <span class="timer-num" id="sess-timer"></span>
  </div>
  <div class="timerbar" id="sess-timerbar" style="display:none"><div></div></div>
  <div class="progress-dots" id="sess-dots"></div>
  <div class="card">
    <div class="q-text" id="sess-q">…</div>
    <div class="q-hint" id="sess-hint"></div>
    <div class="answer-row">
      <input class="answer-input" id="sess-answer" inputmode="decimal" autocomplete="off" placeholder="answer" aria-label="Your answer">
      <button class="btn primary" id="sess-submit" style="min-width:96px">Enter</button>
    </div>
    <div class="keypad" id="sess-keypad">
      <button data-k="7">7</button><button data-k="8">8</button><button data-k="9">9</button><button data-k="⌫">⌫</button>
      <button data-k="4">4</button><button data-k="5">5</button><button data-k="6">6</button><button data-k="/">a/b</button>
      <button data-k="1">1</button><button data-k="2">2</button><button data-k="3">3</button><button data-k="-">−</button>
      <button data-k="0">0</button><button data-k=".">.</button><button data-k="clear">C</button><button data-k="go">↵</button>
    </div>
    <div class="feedback" id="sess-feedback"></div>
    <div class="explain" id="sess-explain"></div>
    <div class="row" style="margin-top:12px;justify-content:space-between">
      <button class="btn ghost" id="sess-skip">Skip</button>
      <button class="btn ghost" id="sess-pause">⏸ Pause</button>
      <button class="btn ghost" id="sess-quit">✕ End</button>
    </div>
  </div>
  <div class="muted small" id="sess-livestat" style="text-align:center"></div>
</section>

<!-- ================= RESULTS ================= -->
<section class="screen" id="scr-results">
  <h1>Session results</h1>
  <div class="card">
    <div class="grid cols3" id="res-stats"></div>
  </div>
  <div class="card" id="res-per-topic"><h2 style="margin-top:0">By topic</h2><table class="tbl" id="res-topic-tbl"></table></div>
  <div class="card" id="res-review"><h2 style="margin-top:0">Mistakes review</h2><div id="res-review-list" class="small"></div></div>
  <div class="grid cols2">
    <button class="btn primary" id="res-again">↻ Again</button>
    <button class="btn" data-go="home">Home</button>
  </div>
</section>

<!-- ================= ANALYTICS ================= -->
<section class="screen" id="scr-analytics" data-nav="analytics">
  <h1>Analytics</h1>
  <div class="card"><div class="grid cols3" id="ana-overview"></div></div>
  <div class="card"><h2 style="margin-top:0">Topic mastery</h2><table class="tbl" id="ana-topics"></table></div>
  <div class="card"><h2 style="margin-top:0">Daily activity (14 days)</h2><canvas class="chart" id="ana-chart" width="640" height="180"></canvas></div>
  <div class="card"><h2 style="margin-top:0">Benchmark history</h2><table class="tbl" id="ana-bench"></table></div>
</section>

<!-- ================= ERRORS ================= -->
<section class="screen" id="scr-errors" data-nav="errors">
  <h1>Error notebook</h1>
  <div class="card">
    <div class="row">
      <select class="sel" id="err-filter" style="flex:1"><option value="">All topics</option></select>
      <button class="btn primary" id="err-revise">▶ Revision session</button>
    </div>
  </div>
  <div id="err-list"></div>
</section>

<!-- ================= TECHNIQUES ================= -->
<section class="screen" id="scr-techniques" data-nav="learn">
  <h1>Technique library</h1>
  <div class="muted small card">The most suitable method depends on the numbers. Learn the conditions, not just the trick.</div>
  <div id="tech-list"></div>
</section>

<!-- ================= SETTINGS ================= -->
<section class="screen" id="scr-settings" data-nav="settings">
  <h1>Settings & backup</h1>
  <div class="card">
    <label class="lbl">Theme</label>
    <div class="pill-toggle" id="set-theme">
      <button class="btn" data-th="light">☀ Light</button>
      <button class="btn" data-th="dark">🌙 Dark</button>
      <button class="btn" data-th="auto">Auto</button>
    </div>
    <label class="lbl">On-screen keypad</label>
    <div class="pill-toggle" id="set-keypad">
      <button class="btn" data-kp="on">Show</button>
      <button class="btn" data-kp="off">Hide</button>
    </div>
    <label class="lbl">Sound-free feedback (visual only)</label>
    <div class="chip">Always on — no audio in this app</div>
  </div>
  <div class="card">
    <h2 style="margin-top:0">Backup & restore</h2>
    <p class="small muted">All progress is stored locally in this browser (localStorage). Export regularly to keep a backup.</p>
    <div class="grid cols2">
      <button class="btn primary" id="set-export">⬇ Export JSON</button>
      <button class="btn" id="set-import-btn">⬆ Import JSON</button>
    </div>
    <input type="file" id="set-import-file" accept="application/json,.json" style="display:none">
    <div id="set-import-msg" class="small" style="margin-top:8px"></div>
  </div>
  <div class="card">
    <h2 style="margin-top:0">Danger zone</h2>
    <button class="btn bad" id="set-reset">🗑 Reset all progress</button>
  </div>
  <div class="card small muted">SSC CGL Calculation Power Trainer · offline-first · no account · no server · v1.0</div>
</section>
</div>

<nav class="bottom">
  <button data-nav="home" class="on"><span class="ic">🏠</span>Home</button>
  <button data-nav="learn"><span class="ic">📘</span>Learn</button>
  <button data-nav="analytics"><span class="ic">📊</span>Stats</button>
  <button data-nav="errors"><span class="ic">📓</span>Errors</button>
  <button data-nav="settings"><span class="ic">⚙️</span>Settings</button>
</nav>

<div class="dialog-back" id="dlg-back"><div class="dialog" id="dlg-body"></div></div>
<div class="toast" id="toast"></div>

<script>
"use strict";
/* ============================================================
   CORE-START — pure logic (no DOM). Testable in Node.
   ============================================================ */
